  "plan": {
    "summary": "按“城市漫步＋朝鲜族文化＋美食”三条主线安排3天：第一天从延边大学、双语弹幕墙和布尔哈通河认识城市；第二天清晨逛水上市场，再集中体验朝鲜族民俗园与帽儿山；第三天乘高铁短途到图们口岸看边境，回到市区补上恐龙博物馆与烧烤。整体节奏休闲，跨城与门票信息均需出发前核实。",
    "assumptions": [
      "未给出发地，默认自行抵达延吉，不含往返大交通",
      "未给日期，按2026年10月下旬秋末、3天2晚安排，昼夜温差大需备外套",
      "按1名成人、休闲节奏、中等预算规划",
      "不含住宿与购物报价；门票、车次与营业时间以现场或官方最新信息为准",
      "市区活动以步行和短途打车为主，跨城优先考虑高铁"
    ],
    "days": [
      {
        "day": 1,
        "title": "城市初识：延边大学、双语街景与河畔夜色",
        "activities": [
          {
            "period": "14:00-16:00",
            "plan": "先到延边大学一带散步，看看校园周边的朝汉双语路牌与“网红弹幕墙”招牌群；这一带适合慢慢走、拍照，感受城市年轻的一面。入校规定与开放区域需现场确认。",
            "sourceIds": [
              "S-8e76f448fb22"
            ]
          },
          {
            "period": "16:30-17:30",
            "plan": "前往延吉天主教堂外观打卡，资料称其建于1911年，日落前斜光较适合拍照；内部是否开放及参观礼仪以现场为准。",
            "sourceIds": [
              "S-8e76f448fb22"
            ]
          },
          {
            "period": "18:00-20:30",
            "plan": "晚餐从延吉冷面、包饭或参鸡汤中选一项，按个人口味点小份多样尝试；饭后沿布尔哈通河散步，作为轻松的收尾。餐价与营业情况待核实。",
            "sourceIds": [
              "S-8e76f448fb22"
            ]
          }
        ]
      },
      {
        "day": 2,
        "title": "朝鲜族文化日：水上市场、民俗园与帽儿山",
        "activities": [
          {
            "period": "05:30-07:30",
            "plan": "早起逛延吉水上市场（资料称约5:00-8:00，需核实季节调整），看现打打糕、米肠和酱菜，挑几样当早餐；早市人多，注意保管随身物品。",
            "sourceIds": [
              "S-8e76f448fb22"
            ]
          },
          {
            "period": "09:00-12:00",
            "plan": "到中国朝鲜族民俗园体验传统民居与服饰，关注农乐舞、长鼓舞等表演场次；资料提到门票约30元、下午3-4点光线较好，票价与演出时间均需以官方当日信息核实。",
            "sourceIds": [
              "S-6de58eda39d3",
              "S-8e76f448fb22"
            ]
          },
          {
            "period": "13:30-16:30",
            "plan": "登帽儿山国家森林公园，沿步道慢行，在山顶俯瞰延吉城区与布尔哈通河；预留往返与休息时间，穿防滑鞋，具体开放与防火管控需现场确认。",
            "sourceIds": [
              "S-6de58eda39d3"
            ]
          },
          {
            "period": "18:00-20:00",
            "plan": "晚餐尝试延吉烧烤，搭配朝鲜族小菜；资料推荐黄牛肉、明太鱼等，可按人数少量多次点单，避免浪费，价格以菜单为准。",
            "sourceIds": [
              "S-8e76f448fb22"
            ]
          }
        ]
      },
      {
        "day": 3,
        "title": "边境半日与城市补漏：图们口岸、恐龙博物馆",
        "activities": [
          {
            "period": "08:30-12:00",
            "plan": "乘高铁短途前往图们口岸（资料称约48公里、车程约15分钟，需核实车次），在铁路国门与界碑附近参观拍照；边境区域请遵守现场标识和工作人员指引，不进入未开放地带。",
            "sourceIds": [
              "S-8e76f448fb22"
            ]
          },
          {
            "period": "14:00-16:00",
            "plan": "返回延吉后参观延吉恐龙博物馆，资料称有大型恐龙化石展示，适合作为室内补充行程；开放时间、预约方式和票价需提前查询。",
            "sourceIds": [
              "S-8e76f448fb22"
            ]
          },
          {
            "period": "16:30-18:30",
            "plan": "到西市场一带采购辣白菜、明太鱼等伴手礼，或找一家咖啡馆尝试苹果梨咖啡等本地限定口味；随后按返程时间前往车站或机场，具体车次与营业时间待核实。",
            "sourceIds": [
              "S-8e76f448fb22"
            ]
          }
        ]
      }
    ],
    "budgetEstimate": "按资料中的大众消费口径粗估：穷游约150元/人/天，舒适型约300-400元/人/天，含餐饮、市内交通与常规门票，不含住宿和往返大交通。民俗园资料提及门票约30元，图们高铁票价、博物馆票价与餐饮实际价格均需现场或官方渠道核实，不作实时价格承诺。",
    "notes": [
      "本次实际读取的两篇资料均为媒体平台旅游文章：搜狐攻略（2025-05-22）与腾讯新闻（2026-05-05），并非政府官网；未能检索到可用的政府页面。",
      "文中开放时间、表演场次、门票、车程与车次均为资料说法，可能随季节调整，出发前请以景区、铁路及当地官方发布为准。",
      "10月下旬延吉早晚偏凉，帽儿山步行和边境参观建议穿防风外套与防滑鞋。",
      "图片取自实际读取的攻略页面，仅作行程氛围参考，未必对应具体每日活动。",
      "未编造实时票价、天气或预订结果；住宿建议按“延边大学/市中心”与“水上市场”两点之间的区域自行比选。"
    ],
