# Studio defaults to deepseek and requires a server-side key for real debugging.
# Set XAGENT_DEFAULT_MODE=mock for an offline Studio; explicit request mode wins.
# XAGENT_DEFAULT_MODE=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
PORT=4391
HOST=127.0.0.1
DATA_DIR=./data
